{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registro-documento (Formulador → Sistema QUEMPIN)",
  "description": "Pide registrar en el Control de Documentos un documento que emitió otra herramienta (hoy: la evaluación de costos del Formulador, tipo 81). Sistema QUEMPIN comprueba que el folio propuesto esté libre; si no, asigna el siguiente y lo informa en el resultado.",
  "destino": "sistema-quempin",
  "type": "object",
  "properties": {
    "documento": {
      "type": "object",
      "properties": {
        "tipo": {
          "enum": [
            "81"
          ]
        },
        "pais": {
          "enum": [
            "Chile",
            "Peru"
          ]
        },
        "folio": {
          "type": "string",
          "pattern": "^\\d{6,}$"
        },
        "fecha": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "autor": {
          "type": "string",
          "minLength": 1
        },
        "referencia": {
          "type": "string",
          "minLength": 1
        },
        "nombreArchivo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tipo",
        "pais",
        "folio",
        "fecha",
        "autor",
        "referencia",
        "nombreArchivo"
      ]
    },
    "proyecto": {
      "type": "object",
      "properties": {
        "req": {
          "type": "string",
          "pattern": "^\\d{1,6}$",
          "description": "N° de la Planilla de Ingreso de Requerimientos"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{2,10}$",
          "description": "TAG del proyecto en Análisis Financiero y Centro de Costos"
        },
        "nombre": {
          "type": "string"
        }
      }
    },
    "fuente": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "codigo": {
          "type": "string"
        },
        "version": {
          "type": [
            "number",
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "documento"
  ]
}
