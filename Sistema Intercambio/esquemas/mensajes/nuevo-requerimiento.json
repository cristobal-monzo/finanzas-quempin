{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nuevo-requerimiento (Formulador o Portal → Planilla de Ingreso)",
  "description": "Un requerimiento nuevo para la Planilla de Ingreso. Lo mandan el Formulador (un proyecto creado sin N° de requerimiento, 2026-10-26: reserva el siguiente N° libre, el que ya llevan su código y su carpeta) y, desde el 2026-10-29, la vista «Planilla de Ingreso» del Portal QUEMPIN, donde el equipo ingresa los requerimientos. planilla_escritura.py lo escribe como fila nueva de la Planilla con Excel, cada 10 minutos. Si ese N° ya lo tomó otro requerimiento: el del Formulador no se escribe y queda rechazado con el motivo; con numeroLibre (el Portal, que todavía no usó ese N° en ninguna carpeta) toma el siguiente libre y lo dice en el resultado.",
  "destino": "planilla-requerimientos",
  "type": "object",
  "properties": {
    "requerimiento": {
      "type": "object",
      "properties": {
        "numero": {
          "type": "integer",
          "minimum": 1
        },
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "estado": {
          "enum": [
            "Evaluación",
            "Ofertado",
            "Adjudicado",
            "Cerrado",
            "No adjudicado",
            "Descartado"
          ]
        },
        "canal": {
          "enum": [
            "Mercado Público",
            "Postventa",
            "Sitio Web",
            "RRSS",
            "Ferias",
            "Otro"
          ]
        },
        "captador": {
          "type": "string"
        },
        "evaluador": {
          "type": "string"
        },
        "cliente": {
          "type": "string"
        },
        "ubicacion": {
          "type": "string"
        },
        "referencia": {
          "type": "string"
        },
        "apertura": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "cierre": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "presupuesto": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "valorOfertado": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "numero",
        "titulo"
      ],
      "additionalProperties": false
    },
    "fuente": {
      "type": "object",
      "properties": {
        "herramienta": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string"
        },
        "codigo": {
          "type": "string"
        }
      },
      "required": [
        "herramienta"
      ]
    },
    "numeroLibre": {
      "type": "boolean"
    }
  },
  "required": [
    "requerimiento",
    "fuente"
  ]
}
