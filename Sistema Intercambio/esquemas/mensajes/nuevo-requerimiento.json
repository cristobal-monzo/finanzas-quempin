{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nuevo-requerimiento (Formulador → Planilla de Ingreso)",
  "description": "Un proyecto creado en el Formulador sin N° de requerimiento (2026-10-26). El Formulador reserva el siguiente N° libre (el que ya llevan su código y su carpeta) y planilla_escritura.py lo escribe como fila nueva de la Planilla con Excel, cada 10 minutos. Si ese N° ya lo tomó otro requerimiento, no se escribe: queda rechazado con el motivo.",
  "destino": "planilla-requerimientos",
  "type": "object",
  "properties": {
    "requerimiento": {
      "type": "object",
      "properties": {
        "numero": {
          "type": "integer",
          "minimum": 1
        },
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "estado": {
          "enum": [
            "Evaluación",
            "Ofertado",
            "Adjudicado",
            "No adjudicado",
            "Descartado"
          ]
        },
        "canal": {
          "enum": [
            "Mercado Público",
            "Sitio Web",
            "RRSS",
            "Ferias",
            "Otro"
          ]
        },
        "captador": {
          "type": "string"
        },
        "evaluador": {
          "type": "string"
        },
        "ubicacion": {
          "type": "string"
        },
        "referencia": {
          "type": "string"
        },
        "apertura": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "cierre": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "presupuesto": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "valorOfertado": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "numero",
        "titulo"
      ],
      "additionalProperties": false
    },
    "fuente": {
      "type": "object",
      "properties": {
        "herramienta": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string"
        },
        "codigo": {
          "type": "string"
        }
      },
      "required": [
        "herramienta"
      ]
    }
  },
  "required": [
    "requerimiento",
    "fuente"
  ]
}
