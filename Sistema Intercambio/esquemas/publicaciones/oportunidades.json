{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oportunidades (evaluación previa de licitaciones de Mercado Público)",
  "description": "Licitaciones publicadas en Mercado Público que se parecen al trabajo de QUEMPIN, con un puntaje de 0 a 100 por criterio (rubro, monto, dificultad, visita a terreno, ubicación, comprador y competencia, plazo para ofertar, tiempo de ejecución), el ponderado, la categoría y los motivos. Solo datos públicos de ChileCompra y la historia de la Planilla; sin nombres ni contactos de funcionarios.",
  "dueno": "oportunidades",
  "type": "object",
  "properties": {
    "consultado": {"type": "string", "minLength": 10},
    "completo": {"type": "boolean"},
    "criterios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"enum": ["rubro", "monto", "dificultad", "visita", "ubicacion", "comprador", "plazoOferta", "ejecucion"]},
          "nombre": {"type": "string", "minLength": 1},
          "peso": {"type": "number", "minimum": 0},
          "descripcion": {"type": "string"}
        },
        "required": ["id", "nombre", "peso"]
      }
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "nombre": {"type": "string", "minLength": 1},
          "desde": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "required": ["id", "nombre", "desde"]
      }
    },
    "reglas": {
      "type": "object",
      "properties": {
        "plazoOferta": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "menosDeDias": {"type": ["number", "null"]},
              "puntaje": {"type": "number", "minimum": 0, "maximum": 100}
            },
            "required": ["menosDeDias", "puntaje"]
          }
        },
        "visitaPasada": {"type": "object"}
      },
      "required": ["plazoOferta", "visitaPasada"]
    },
    "perfil": {
      "type": "object",
      "properties": {
        "historia": {"type": "object"},
        "montoHabitual": {"type": "object"},
        "mercado": {"type": "object"},
        "competidores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nombre": {"type": "string"},
              "ganadas": {"type": "integer", "minimum": 0},
              "monto": {"type": "number", "minimum": 0}
            },
            "required": ["nombre", "ganadas"]
          }
        }
      }
    },
    "oportunidades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {"type": "string", "pattern": "^[0-9]+-[0-9]+-[A-Z][A-Z0-9]{1,3}[0-9]{2}$"},
          "url": {"type": "string", "pattern": "^https://(www|buscador)\\.mercadopublico\\.cl/"},
          "nombre": {"type": ["string", "null"]},
          "organismo": {"type": ["string", "null"]},
          "region": {"type": ["string", "null"]},
          "cierre": {"type": ["string", "null"]},
          "puntaje": {"type": "number", "minimum": 0, "maximum": 100},
          "categoria": {"type": "string", "minLength": 1},
          "descartar": {"type": "array", "items": {"type": "string"}},
          "descartarFijo": {"type": "array", "items": {"type": "string"}},
          "aFavor": {"type": "array", "items": {"type": "string"}},
          "enContra": {"type": "array", "items": {"type": "string"}},
          "regionCorta": {"type": ["string", "null"]},
          "criterios": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "puntaje": {"type": "integer", "minimum": 0, "maximum": 100},
                "motivo": {"type": "string"}
              },
              "required": ["puntaje", "motivo"]
            }
          },
          "probabilidadGanar": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "parecidas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "req": {"type": ["integer", "null"]},
                "titulo": {"type": ["string", "null"]},
                "estado": {"type": "string"},
                "similitud": {"type": "number", "minimum": 0}
              },
              "required": ["req", "estado"]
            }
          },
          "mercado": {"type": "array", "items": {"type": "object"}},
          "enPlanilla": {"anyOf": [{"type": "null"}, {"type": "object", "properties": {"req": {"type": ["integer", "null"]}}}]},
          "ficha": {"type": "boolean"}
        },
        "required": ["codigo", "url", "puntaje", "categoria", "descartar", "criterios", "ficha"]
      }
    },
    "avisos": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["consultado", "criterios", "categorias", "perfil", "oportunidades"]
}
