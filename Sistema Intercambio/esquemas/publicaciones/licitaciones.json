{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "licitaciones (monitor de Mercado Público)",
  "description": "Resultado en Mercado Público de cada requerimiento de la Planilla con código de licitación, quién ganó y por cuánto, y las órdenes de compra emitidas a QUEMPIN. Solo datos públicos de ChileCompra, sin datos de contacto de funcionarios.",
  "dueno": "mercado-publico",
  "type": "object",
  "properties": {
    "proveedor": {
      "type": "object",
      "properties": {
        "rut": {"type": "string", "minLength": 1},
        "codigo": {"type": "string", "minLength": 1},
        "nombre": {"type": "string"}
      },
      "required": ["rut", "codigo"]
    },
    "consultado": {"type": "string", "minLength": 10},
    "completo": {"type": "boolean"},
    "licitaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "req": {"type": "integer", "minimum": 1},
          "codigo": {"type": "string", "pattern": "^[0-9]+-[0-9]+-[A-Z][A-Z0-9]{1,3}[0-9]{2}$"},
          "resultado": {"enum": ["ganada", "perdida", "desierta", "revocada", "suspendida", "abierta", "en-evaluacion", "adjudicada-sin-detalle", "compra-agil", "no-encontrada", "otro"]},
          "url": {"type": "string", "pattern": "^https://www\\.mercadopublico\\.cl/"},
          "urlActa": {"type": ["string", "null"], "pattern": "^https://www\\.mercadopublico\\.cl/"},
          "nombre": {"type": ["string", "null"]},
          "comprador": {"type": ["string", "null"]},
          "planilla": {"type": ["string", "null"]},
          "montoQuempin": {"type": ["number", "null"], "minimum": 0},
          "oferentes": {"type": ["integer", "null"], "minimum": 0},
          "adjudicados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rut": {"type": ["string", "null"]},
                "nombre": {"type": ["string", "null"]},
                "montoNeto": {"type": "number", "minimum": 0}
              },
              "required": ["montoNeto"]
            }
          },
          "ordenes": {"type": "array", "items": {"type": "string"}},
          "motivo": {"type": ["string", "null"]}
        },
        "required": ["req", "codigo", "resultado", "url"]
      }
    },
    "ordenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {"type": "string", "pattern": "^[0-9]+-[0-9]+-[A-Z][A-Z0-9]{1,3}[0-9]{2}$"},
          "url": {"type": "string", "pattern": "^https://www\\.mercadopublico\\.cl/"},
          "total": {"type": ["number", "null"], "minimum": 0},
          "adquisicion": {"type": ["string", "null"]}
        },
        "required": ["codigo", "url"]
      }
    },
    "ordenesSinRequerimiento": {"type": "array", "items": {"type": "string"}},
    "revisar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "req": {"type": "integer", "minimum": 1},
          "codigo": {"type": "string"},
          "texto": {"type": "string", "minLength": 1}
        },
        "required": ["req", "texto"]
      }
    },
    "resumen": {
      "type": "object",
      "properties": {
        "ganadas": {"type": "integer", "minimum": 0},
        "perdidas": {"type": "integer", "minimum": 0},
        "desiertas": {"type": "integer", "minimum": 0},
        "enEspera": {"type": "integer", "minimum": 0},
        "tasaAdjudicacion": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "required": ["ganadas", "perdidas"]
    },
    "avisos": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["proveedor", "consultado", "licitaciones", "ordenes", "revisar", "resumen"]
}
