{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flujo-caja (Flujo de Caja)",
  "description": "Ingresos y egresos por mes: por cobrar, probables, comprometidos y reales.",
  "dueno": "flujo-caja",
  "type": "object",
  "properties": {
    "moneda": {
      "type": "string",
      "minLength": 1
    },
    "meses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mes": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          }
        },
        "required": [
          "mes"
        ]
      }
    },
    "lineas": {
      "type": "array"
    },
    "supuestos": {
      "type": "object"
    }
  },
  "required": [
    "moneda",
    "meses"
  ]
}
