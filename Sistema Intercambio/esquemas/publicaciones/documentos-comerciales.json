{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "documentos-comerciales (Sistema QUEMPIN)",
  "description": "Cotizaciones (60) y órdenes de compra (61) emitidas, con su proyecto, montos y cuotas de pago, más el estado de los mensajes que recibió Sistema QUEMPIN (borradores y registros).",
  "dueno": "sistema-quempin",
  "type": "object",
  "properties": {
    "documentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "enum": [
              "60",
              "61"
            ]
          },
          "folio": {
            "type": "string",
            "minLength": 1
          },
          "pais": {
            "enum": [
              "Chile",
              "Peru"
            ]
          },
          "fecha": {
            "type": "string"
          },
          "referencia": {
            "type": "string"
          },
          "contraparte": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "rut": {
                "type": "string"
              },
              "razon_social": {
                "type": "string"
              },
              "pais": {
                "type": "string"
              },
              "ciudad": {
                "type": "string"
              }
            },
            "required": [
              "razon_social"
            ]
          },
          "proyecto": {
            "type": "object",
            "properties": {
              "req": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "moneda": {
            "type": "string",
            "minLength": 1
          },
          "neto": {
            "type": [
              "number",
              "null"
            ]
          },
          "impuesto": {
            "type": [
              "number",
              "null"
            ]
          },
          "total": {
            "type": [
              "number",
              "null"
            ]
          },
          "cuotas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "porcentaje": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "condicion": {
                  "type": "string"
                },
                "monto": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "autor": {
            "type": "string"
          },
          "origen": {
            "type": "object"
          }
        },
        "required": [
          "tipo",
          "folio",
          "pais",
          "fecha",
          "contraparte",
          "moneda",
          "total"
        ]
      }
    },
    "mensajes": {
      "type": "object"
    }
  },
  "required": [
    "documentos"
  ]
}
