{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uso-portal/<dispositivo>.json (qué herramientas se abren en el Portal)",
  "description": "Cuántas veces se abrió cada herramienta o vista del Portal QUEMPIN por día, en un navegador (2026-11-09). Anónimo: sin usuario, solo el id aleatorio del navegador. Sirve para decidir qué mejorar con datos y no a ciegas. Guarda los últimos 90 días.",
  "dueno": "portal",
  "type": "object",
  "properties": {
    "dispositivo": {
      "type": "string",
      "pattern": "^[a-z0-9]{8,24}$"
    },
    "dias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "herramienta": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "aperturas": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "fecha",
          "herramienta",
          "aperturas"
        ]
      }
    }
  },
  "required": [
    "dispositivo",
    "dias"
  ]
}
